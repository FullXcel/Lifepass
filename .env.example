# LifePass backend
LIFEPASS_API_PORT=8787
LIFEPASS_ADMIN_TOKEN=여기에_openssl_rand_hex_32_결과를_넣기

# Bokjiro / 복지로 중앙부처·지자체 복지서비스
BOKJIRO_SERVICE_KEY=공공데이터포털에서_발급받은_복지로_API_서비스키
BOKJIRO_CENTRAL_API_URL=http://apis.data.go.kr/B554287/NationalWelfareInformationsV001/NationalWelfarelistV001
BOKJIRO_CENTRAL_DETAIL_API_URL=http://apis.data.go.kr/B554287/NationalWelfareInformationsV001/NationalWelfaredetailedV001
BOKJIRO_LOCAL_API_URL=http://apis.data.go.kr/B554287/LocalGovernmentWelfareInformations

# Gov24 / 대한민국 공공서비스 혜택 정보
GOV24_SERVICE_KEY=공공데이터포털에서_발급받은_정부24_API_서비스키
GOV24_BENEFIT_API_URL=https://api.odcloud.kr/api/gov24/v3/serviceList
GOV24_DETAIL_API_URL=https://api.odcloud.kr/api/gov24/v3/serviceDetail
GOV24_SUPPORT_CONDITIONS_API_URL=https://api.odcloud.kr/api/gov24/v3/supportConditions

# 온통청년 / 청년정책
YOUTH_POLICY_API_KEY=온통청년에서_발급받은_인증키
YOUTH_POLICY_API_URL=https://www.youthcenter.go.kr/opi/youthPlcyList.do

# 마이홈 / 공공주택·임대주택
MYHOME_SERVICE_KEY=공공데이터포털에서_발급받은_마이홈_API_서비스키
MYHOME_PUBLIC_HOUSING_NOTICE_API_URL=https://www.data.go.kr/data/15108420/openapi.do
MYHOME_RENTAL_HOUSING_COMPLEX_API_URL=https://www.data.go.kr/data/15110581/openapi.do
MYHOME_WAITING_LIST_API_URL=https://www.data.go.kr/data/15108378/openapi.do

# WorkNet / 고용·채용 보조 데이터
WORKNET_SERVICE_KEY=발급받은_워크넷_API_서비스키
WORKNET_JOB_API_URL=워크넷_채용정보_API_엔드포인트

# 허용된 지자체 공고문 보조 수집
ENABLE_LOCAL_NOTICE_CRAWLER=false
LOCAL_NOTICE_URLS=