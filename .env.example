# LifePass backend
LIFEPASS_API_PORT=8787
LIFEPASS_API_HOST=0.0.0.0
# 필수: 운영/공개 데모 배포 시 반드시 충분히 긴 임의 문자열로 설정하세요.
LIFEPASS_ADMIN_TOKEN=replace-with-a-long-random-token
# 쉼표로 여러 출처 허용 가능. 예: http://localhost:5173,https://your-domain.example
LIFEPASS_CORS_ORIGIN=http://localhost:5173
# true로 두면 토큰 누락 시 관리자 API를 차단합니다. 운영에서는 항상 true 권장.
LIFEPASS_REQUIRE_ADMIN_TOKEN=true
# 업로드/요청 본문 크기 제한
LIFEPASS_MAX_BODY_BYTES=1048576

# PostgreSQL cache/store
# DATABASE_URL이 있으면 정책/법령/원문/캐시를 PostgreSQL에 저장합니다.
# 없으면 server/data/policy_store JSON 파일 저장소를 사용합니다.
DATABASE_URL=
POLICY_REFRESH_TTL_HOURS=24

# Policy ingestion scheduler
POLICY_FETCH_TIMEOUT_MS=15000
POLICY_SCHEDULER_INTERVAL_MS=21600000
POLICY_MAX_PAGES_PER_SOURCE=3
POLICY_MAX_DETAILS_PER_SOURCE=25
POLICY_INGEST_DRY_RUN=false

# Bokjiro / 복지로 중앙부처·지자체 복지서비스
ENABLE_BOKJIRO_CENTRAL=true
ENABLE_BOKJIRO_LOCAL=true
BOKJIRO_SERVICE_KEY=공공데이터포털에서_발급받은_복지로_API_서비스키
BOKJIRO_CENTRAL_SERVICE_KEY=
BOKJIRO_LOCAL_SERVICE_KEY=
BOKJIRO_CENTRAL_API_URL=http://apis.data.go.kr/B554287/NationalWelfareInformationsV001/NationalWelfarelistV001
BOKJIRO_CENTRAL_DETAIL_API_URL=http://apis.data.go.kr/B554287/NationalWelfareInformationsV001/NationalWelfaredetailedV001
BOKJIRO_LOCAL_API_URL=http://apis.data.go.kr/B554287/LocalGovernmentWelfareInformations
BOKJIRO_LOCAL_DETAIL_API_URL=http://apis.data.go.kr/B554287/LocalGovernmentWelfareInformations/LcgvWelfaredetailed

# Gov24 / 대한민국 공공서비스 혜택 정보
ENABLE_GOV24_BENEFITS=true
GOV24_SERVICE_KEY=공공데이터포털에서_발급받은_정부24_API_서비스키
GOV24_BENEFIT_API_URL=https://api.odcloud.kr/api/gov24/v3/serviceList
GOV24_DETAIL_API_URL=https://api.odcloud.kr/api/gov24/v3/serviceDetail
GOV24_SUPPORT_CONDITIONS_API_URL=https://api.odcloud.kr/api/gov24/v3/supportConditions

# 국가법령정보센터 / 복지·주거·고용 관련 현행 법령 근거
ENABLE_LAW_WELFARE_ACTS=true
LAW_OPEN_API_OC=국가법령정보센터_OPEN_API_OC값
LAW_SEARCH_API_URL=http://www.law.go.kr/DRF/lawSearch.do
LAW_SERVICE_API_URL=http://www.law.go.kr/DRF/lawService.do
LAW_POLICY_QUERIES=복지,기초생활보장,청년,주거급여,고용보험

# 온통청년 / 청년정책
ENABLE_YOUTH_POLICY=false
YOUTH_POLICY_API_KEY=온통청년에서_발급받은_인증키
YOUTH_POLICY_API_URL=https://www.youthcenter.go.kr/opi/youthPlcyList.do

# 마이홈 / 공공주택·임대주택
# 주의: 아래 data.go.kr 주소는 API 소개 페이지일 수 있습니다.
# 실제 호출 엔드포인트를 활용가이드/Swagger에서 확인한 뒤 교체하고 ENABLE_MYHOME_* 값을 true로 바꾸세요.
ENABLE_MYHOME_PUBLIC_HOUSING_NOTICE=false
ENABLE_MYHOME_RENTAL_HOUSING_COMPLEX=false
ENABLE_MYHOME_WAITING_LIST=false
MYHOME_SERVICE_KEY=공공데이터포털에서_발급받은_마이홈_API_서비스키
MYHOME_PUBLIC_HOUSING_NOTICE_API_URL=https://www.data.go.kr/data/15108420/openapi.do
MYHOME_RENTAL_HOUSING_COMPLEX_API_URL=https://www.data.go.kr/data/15110581/openapi.do
MYHOME_WAITING_LIST_API_URL=https://www.data.go.kr/data/15108378/openapi.do

# WorkNet / 고용·채용 보조 데이터
ENABLE_WORKNET_JOBS=false
WORKNET_SERVICE_KEY=발급받은_워크넷_API_서비스키
WORKNET_JOB_API_URL=워크넷_채용정보_API_엔드포인트

# 허용된 지자체 공고문 보조 수집
ENABLE_LOCAL_NOTICE_CRAWLER=false
LOCAL_NOTICE_URLS=
